# Copy to .env. Keep real credentials in .env, never in browser JavaScript.
MONGODB_URI=mongodb+srv://DATABASE_USER:ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=economic_brief
PORT=3000
HOST=127.0.0.1
# Required in production; set this to the exact public HTTPS origin.
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
# Persist this directory on your host. Relative paths resolve from the project root.
UPLOAD_DIR=uploads
# Behind one trusted HTTPS reverse proxy, set TRUST_PROXY=1.
TRUST_PROXY=0
