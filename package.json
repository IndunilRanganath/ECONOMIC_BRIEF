{
  "name": "economic-brief",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server/index.js",
    "dev": "node --env-file-if-exists=.env --watch server/index.js",
    "admin:create": "node --env-file-if-exists=.env scripts/create-admin.js",
    "test": "node --test --test-concurrency=1 tests/*.test.js",
    "build:vercel": "node scripts/build-vercel.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "mongodb": "^7.7.0",
    "multer": "^2.5.0",
    "sanitize-html": "^2.18.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
